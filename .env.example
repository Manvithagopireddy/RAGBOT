# ── RAGBOT Environment Configuration ──────────────────────────────────────────

# Google Gemini API Key (Required for LLM generation)
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Configuration
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_OUTPUT_TOKENS=8192

# Chunking & Embedding Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_METHOD=token
TOKEN_CHUNK_SIZE=250
TOKEN_CHUNK_OVERLAP=40
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Hybrid Retrieval & Reranking
RETRIEVER_K=4
SIMILARITY_SCORE_THRESHOLD=0.35
HYBRID_SEARCH_ENABLED=true
RRF_K=60
HYBRID_ALPHA=0.5
RERANKING_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=4

# Context Window & Defense
MAX_CONTEXT_TOKENS=3500

# Backend & Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_RPM=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
